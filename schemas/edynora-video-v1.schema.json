{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "videoTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "chapters": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "startSeconds",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "keyThemes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "audience": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "callsToAction": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      }
    },
    "sourceReferences": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "uri": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "label",
          "uri"
        ],
        "additionalProperties": false
      }
    },
    "approvalMetadata": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "review-required",
            "approved",
            "exported"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "videoTitle",
    "description",
    "chapters",
    "keyThemes",
    "audience",
    "callsToAction",
    "sourceReferences",
    "approvalMetadata"
  ],
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "transcript"
      ]
    },
    {
      "required": [
        "script"
      ]
    }
  ]
}
